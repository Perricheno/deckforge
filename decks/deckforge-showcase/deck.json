      "layout": "cards", "n": 1, "bg": "grid", "bg_opts": {"alpha": 0.7},
      "tag": "Motion graphics", "title": "Every visual moves, and *never repeats* exactly",
      "lead": "Markers, packets and highlights run on their own rhythms, so the picture never lines up twice.",
      "cards": [
        {"icon": "equal", "title": "Converging lines", "t": "A marker rides each curve with a pulsing halo.", "viz": {"kind": "converge"}, "cap": "Lines drawn on entry, then looped."},
        {"icon": "trendingDown", "title": "Decay curves", "t": "Fills and markers move on different periods.", "viz": {"kind": "decay"}, "cap": "Period 6.3 s, drifting phase."},
        {"icon": "copy", "title": "Packets", "t": "Requests flow into one box at random moments.", "viz": {"kind": "packets"}, "cap": "Random spawn, eased paths."}
      ]
    },
    {
      "layout": "flow", "n": 2, "bg": "waves", "bg_opts": {"y": 0.93}, "tag": "Pipeline", "title": "One file in, a *live site and a PDF* out",
      "blocks": [
        {"type": "flowcards", "nodes": [
          {"icon": "fileText", "title": "deck.json", "label": "You write", "items": ["Slides as data", "No HTML or CSS", "Icons by name"]},
          {"icon": "layers", "title": "Build", "label": "Automatic", "items": ["Layouts and blocks", "Icon check", "Rebuild on save"]},
          {"icon": "sparkles", "title": "Motion engine", "label": "Runtime", "out": true, "subs": [["Scenes", "aurora, grid"], ["Behaviors", "flow, morph"], ["Keyframes", "x y s r o"]], "items": ["Plugins per deck"]},
          {"icon": "send", "title": "Present", "label": "On stage", "items": ["Phone remote", "Speaker notes", "PDF download"]}
        ]},
        {"type": "mod", "icon": "lightbulb", "t": "**Tip:** the whole engine is a registry. Add a behavior in `plugin.js` and any element can use it with a data attribute."},
        {"type": "html", "html": "<div data-heartbeat class=\"note\" style=\"margin-top:10px\"><span>Custom plugin running: this note pulses from decks/deckforge-showcase/plugin.js</span></div>"}
      ],
      "columns": [
        [{"type": "minis", "eyebrow": "Cheap for the author", "items": [{"icon": "fileText", "b": "Content only.", "t": "The model writes JSON, never markup."}, {"icon": "timer", "b": "Instant.", "t": "Saved files are live in about a second."}]}],
        [{"type": "minis", "eyebrow": "Flexible for the designer", "items": [{"icon": "sparkles", "b": "data-motion.", "t": "float, pulse, spin, sway, breathe, wobble."}, {"icon": "workflow", "b": "Keyframes.", "t": "Timelines with easing, ping-pong and jitter."}]}],
        [{"type": "notes", "eyebrow": "Safe by default", "items": [{"b": "Reduced motion:", "t": "respected unless the deck opts out."}, {"b": "PDF:", "t": "static frame, no loops."}, {"b": "Thumbnails:", "t": "driven by the gallery.", "solid": true}]}]
