      "title": "Curves with *moving markers*",
      "left": [
        {"type": "text", "t": "Give a handful of points per series. The engine draws a smooth line, fills the area to a baseline and walks a marker along it.", "cls": "lead"},
        {"type": "bullets", "items": [
          {"b": "Series.", "t": "Any number of lines, each with its own colour and period."},
          {"b": "Phases.", "t": "Brackets under the axis label stages of the story."},
          {"b": "Baseline.", "t": "A dashed reference that shades gains and dips."}]}
      ],
      "chart": {
        "series": [
          {"name": "With the engine", "color": "acc", "width": 2.6, "fill": 0.08, "period": 10.5, "pts": [[0, 50], [14, 44], [30, 28], [48, 30], [66, 62], [82, 84], [100, 92]]},
